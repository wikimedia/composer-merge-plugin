    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=7.4.0",
        "composer-plugin-api": "^1.1||^2.0",
        "vakata/jstree": "3.3.17",
        "abantecart/ups-php": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Wikimedia\\Composer\\Merge\\V2\\": "src/",
            "UpsPhp\\": "vendor/abantecart/ups-php/src/"
        }
    }
}

